# UpWatch environment variables (set in Lovable Cloud → Settings → Secrets)

# --- Supabase (auto-configured by Lovable Cloud) ---
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Uptime Kuma (status.upwatch.online) ---
# Run: cd infra/uptime-kuma && ./setup.ps1  (or setup.sh on Linux)
# Cloudflare Tunnel is recommended — see infra/uptime-kuma/.env.example
KUMA_BASE_URL=https://status.upwatch.online
KUMA_STATUS_PAGE_SLUG=upwatch
VITE_KUMA_PUBLIC_URL=https://status.upwatch.online/status/upwatch

# --- Public status page on UpWatch (always works as fallback) ---
VITE_STATUS_PAGE_URL=https://upwatch.online/status

# --- Monitor runner (cron hits this; migration 20260724200000 sets pg_cron URL) ---
# CRON_SECRET=optional-extra-auth-for-run-monitors-hook

# --- Alerts ---
# BREVO_API_KEY=
# TELEGRAM_BOT_TOKEN=

# --- Production deploy (GitHub Actions → Cloudflare Workers) ---
# CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID, SUPABASE_SERVICE_ROLE_KEY

# --- Remote Kuma deploy (optional GitHub Action) ---
# KUMA_SSH_HOST, KUMA_SSH_USER, KUMA_SSH_KEY, CLOUDFLARE_TUNNEL_TOKEN
