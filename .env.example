# UpWatch environment variables (Cloudflare Workers secrets or GitHub Actions)

# --- Supabase ---
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Uptime Kuma (status.upwatch.online) ---
KUMA_BASE_URL=https://status.upwatch.online
KUMA_STATUS_PAGE_SLUG=upwatch
VITE_KUMA_PUBLIC_URL=https://status.upwatch.online/status/upwatch

# --- Public status page on UpWatch (fallback when Kuma unavailable) ---
VITE_STATUS_PAGE_URL=https://upwatch.online/status

# --- Monitor runner (pg_cron → /api/public/hooks/run-monitors) ---
# CRON_SECRET=optional-extra-auth-for-run-monitors-hook

# --- Alerts (direct Brevo API — no third-party gateway) ---
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=alerts@upwatch.online
# TELEGRAM_BOT_TOKEN=

# --- Production deploy (GitHub Actions → Cloudflare Workers) ---
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# --- Remote Kuma deploy (optional GitHub Action) ---
# KUMA_SSH_HOST, KUMA_SSH_USER, KUMA_SSH_KEY, CLOUDFLARE_TUNNEL_TOKEN
