# UpWatch environment variables (set in Lovable Cloud → Settings → Secrets)

# --- Supabase (auto-configured by Lovable Cloud) ---
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Uptime Kuma (optional — powers status.upwatch.online) ---
# Deploy Uptime Kuma on a server, point status.upwatch.online DNS to it (NOT Umami/analytics).
# Create a public status page in Kuma with slug "upwatch", then set:
# KUMA_BASE_URL=https://status.upwatch.online
# KUMA_STATUS_PAGE_SLUG=upwatch
# VITE_KUMA_PUBLIC_URL=https://status.upwatch.online/status/upwatch

# --- Public status page links (shown in UI) ---
# VITE_STATUS_PAGE_URL=https://upwatch.online/status

# --- Monitor runner (cron hits this; migration 20260724200000 sets pg_cron URL) ---
# CRON_SECRET=optional-extra-auth-for-run-monitors-hook

# --- Alerts ---
# BREVO_API_KEY=
# TELEGRAM_BOT_TOKEN=

# --- Production deploy (GitHub Actions → Cloudflare Workers) ---
# Lovable Git sync updates the editor preview only; it does NOT publish upwatch.online.
# Add these as GitHub repo secrets for .github/workflows/deploy.yml:
# CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID
# SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY, SUPABASE_SERVICE_ROLE_KEY
# VITE_SUPABASE_URL, VITE_SUPABASE_PUBLISHABLE_KEY
# VITE_BUILD_SHA is set automatically in CI from the git commit.
