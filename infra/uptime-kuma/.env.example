# Copy to .env in this folder before running docker compose.

# --- Cloudflare Tunnel (recommended — status.upwatch.online is already on Cloudflare) ---
# 1. Zero Trust → Networks → Tunnels → Create tunnel → Cloudflared
# 2. Public hostname: status.upwatch.online → http://uptime-kuma:3001
# 3. Paste the tunnel token below (removes Umami from that subdomain automatically)
CLOUDFLARE_TUNNEL_TOKEN=

# --- Direct VPS mode (alternative to tunnel) ---
# Point status.upwatch.online A record to your server IP, then: docker compose --profile caddy up -d
KUMA_HOST_PORT=3001
KUMA_DOMAIN=status.upwatch.online

# --- UpWatch app integration (set same values in Lovable / GitHub Actions secrets) ---
KUMA_BASE_URL=https://status.upwatch.online
KUMA_STATUS_PAGE_SLUG=upwatch
VITE_KUMA_PUBLIC_URL=https://status.upwatch.online/status/upwatch
